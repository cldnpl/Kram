    plt.text(0.05, 0.5, wrapped_text, fontsize=10, family='monospace', va='center')
    plt.axis('off')
    plt.savefig(filepath, bbox_inches='tight', dpi=120)
    plt.close()

print("Kram sta iniziando a generare le sue prime 100 immagini...")

# 3. Creiamo il file di metadati e le immagini
with open('dataset/metadata.jsonl', 'w') as f:
    # Testiamo con i primi 100 per ora (così è veloce)
    for i, row in df.head(100).iterrows():
        img_name = f"img_{i}.png"
        img_path = f"dataset/images/{img_name}"
        
        # Genera l'immagine fisica
        text_to_image(row['problem'], img_path)
        
        # Scrivi il metadato collegando l'immagine alla soluzione
